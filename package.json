{
  "name": "pele-preview",
  "version": "0.1.0",
  "description": "Preview or export a Mermaid diagram rendered by pele, with your own CSS embedded in the SVG.",
  "type": "module",
  "bin": {
    "pele-preview": "bin/pele-preview"
  },
  "files": [
    "bin",
    "src",
    "pele-plex.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "jasmine --config=jasmine.json && node --test test/evals/plex.test.js",
    "test:property": "jasmine --config=jasmine.json \"test/*.property.test.js\"",
    "mutate": "stryker run",
    "check": "eslint . && npm audit --omit=dev",
    "evals": "npm test && scripts/check-eval-links.sh"
  },
  "dependencies": {
    "pele": "^1.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "jasmine": "6.3.0",
    "jasmine-spec-reporter": "7.0.0",
    "playwright": "^1.65.0"
  }
}
