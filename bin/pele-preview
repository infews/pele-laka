#!/usr/bin/env node
import { readFileSync, writeFileSync } from "node:fs";
import { parse, UsageError, HelpRequested } from "../src/cli.js";
import { readAndCompose, readAndComposeAll, describeError, palettesIn } from "../src/compose.js";
import { startServer } from "../src/server.js";
import { watchFiles } from "../src/watcher.js";
import { launch } from "../src/browser.js";

const options = parseOrExit(process.argv.slice(2));
const describe = (error) => describeError(error, options.diagram);

warnAboutUnknownPalette();

if (options.output) {
  exportSvg();
} else {
  await preview();
}

// Not an error: the palette may come from a stylesheet the SVG is later shown
// with, or the name may simply be wrong. Either way, say so once.
function warnAboutUnknownPalette() {
  if (!options.palette) return;
  const css = options.stylesheet ? readFileSync(options.stylesheet, "utf8") : "";
  const known = palettesIn(css);
  if (known.includes(options.palette)) return;
  const where = options.stylesheet ?? "(no stylesheet)";
  const offer = known.length ? ` (it defines: ${known.join(", ")})` : "";
  console.error(`warning: palette "${options.palette}" is not defined in ${where}${offer}`);
}

function parseOrExit(argv) {
  try {
    return parse(argv);
  } catch (error) {
    if (error instanceof HelpRequested) {
      console.log(error.message);
      process.exit(0);
    }
    if (error instanceof UsageError) {
      console.error(error.message);
      process.exit(2);
    }
    throw error;
  }
}

function exportSvg() {
  try {
    writeFileSync(options.output, readAndCompose(options));
    console.log(`wrote ${options.output}`);
  } catch (error) {
    console.error(describe(error));
    process.exit(1);
  }
}

async function preview() {
  let server;
  try {
    server = await startServer({
      port: options.port,
      scheme: options.scheme,
      palette: options.palette,
      render: () => readAndComposeAll(options),
      describe,
    });
  } catch (error) {
    console.error(`could not start server: ${error.message}`);
    process.exit(1);
  }

  const report = ({ revision, error }) =>
    error ? console.error(error) : console.log(`rendered (revision ${revision})`);
  if (server.initial.error) console.error(server.initial.error);

  const files = [options.diagram, options.stylesheet].filter(Boolean);
  const watcher = watchFiles(files, () => report(server.refresh()));

  console.log(`pele-preview: ${server.url}  (Ctrl-C to stop)`);
  if (options.open) launch(server.url, { app: options.browserApp });

  process.once("SIGINT", async () => {
    watcher.close();
    await server.close();
    process.exit(0);
  });
}
